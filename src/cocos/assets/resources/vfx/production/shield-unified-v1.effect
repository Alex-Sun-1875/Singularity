CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: shield-vs:vert
      frag: shield-fs:frag
      rasterizerState: { cullMode: front }
      depthStencilState: &depth
        depthTest: true
        depthWrite: false
      blendState: &blend
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
      properties:
        mainTexture: { value: white }
        shieldTint: { value: [1, 0.59, 0.27, 1], linear: true, editor: { type: color } }
        motifChannel: { value: [0, 0, 1, 0] }
        shieldState: { value: [1, 1, 1, 0] }
        hitState: { value: [0, 0, 1, -1] }
        motionState: { value: [1, 0, 0, 0] }
    - vert: shield-vs:vert
      frag: shield-fs:frag
      propertyIndex: 0
      rasterizerState: { cullMode: back }
      depthStencilState: *depth
      blendState: *blend
}%

CCProgram shield-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec3 a_normal;
  in vec2 a_texCoord;
  out vec3 v_normal;
  out vec3 v_local;
  out vec2 v_uv;
  vec4 vert () {
    v_normal = normalize(mat3(cc_matWorldIT) * a_normal);
    v_local = a_position * 2.0;
    v_uv = a_texCoord;
    return cc_matViewProj * cc_matWorld * vec4(a_position, 1.0);
  }
}%

CCProgram shield-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <legacy/output-standard>
  in vec3 v_normal;
  in vec3 v_local;
  in vec2 v_uv;
  uniform sampler2D mainTexture;
  uniform ShieldParams {
    vec4 shieldTint;
    vec4 motifChannel;
    vec4 shieldState;
    vec4 hitState;
    vec4 motionState;
  };

  // Generated from the same approved C palette as the fire flipbooks.
  vec3 fireFamilyColour(float heat) {
    if (heat < 0.200) return mix(vec3(0.60784314, 0.23921569, 0.02745098), vec3(0.85098039, 0.36078431, 0.02352941), clamp((heat-0.000)/0.200, 0.0, 1.0));
    if (heat < 0.900) return mix(vec3(0.85098039, 0.36078431, 0.02352941), vec3(0.97647059, 0.54117647, 0.04313725), clamp((heat-0.200)/0.700, 0.0, 1.0));
    if (heat < 0.985) return mix(vec3(0.97647059, 0.54117647, 0.04313725), vec3(1.00000000, 0.77254902, 0.26666667), clamp((heat-0.900)/0.085, 0.0, 1.0));
    return mix(vec3(1.00000000, 0.77254902, 0.26666667), vec3(1.00000000, 0.96862745, 0.63137255), clamp((heat-0.985)/0.015, 0.0, 1.0));
  }
  vec4 frag () {
    vec3 n = normalize(v_normal);
    vec3 view = normalize(cc_matViewInv[2].xyz);
    float fresnel = pow(1.0 - abs(dot(n, view)), 1.55);
    float rim = smoothstep(0.28, 0.94, fresnel) * 0.38 + pow(fresnel, 5.0) * 0.22;
    // Keep the paired curved motifs readable from the gameplay camera rather
    // than turning a blank texture seam toward it when the player faces away.
    float side = dot(n, normalize(cc_matViewInv[0].xyz));
    float depth = sqrt(max(0.001, 1.0 - side * side - v_local.y * v_local.y));
    vec2 uv = vec2(atan(side, depth) / 3.141593 + 0.5, 0.5 - asin(clamp(v_local.y, -1.0, 1.0)) / 3.141593);
    float glyph = dot(texture(mainTexture, uv), motifChannel);
    glyph *= smoothstep(0.22, 0.42, abs(side));
    float front = -1.08 + clamp(shieldState.x / 0.32, 0.0, 1.0) * 2.2;
    float reveal = 1.0 - smoothstep(front - 0.055, front + 0.055, v_local.y);
    float breath = 1.0 + 0.035 * sin(shieldState.x * 3.92699) * motionState.x;
    float alpha = (0.038 + fresnel * 0.055 + rim + glyph * 0.70 * shieldState.z) * breath;
    float ripple = 0.0;
    if (hitState.w >= 0.0 && hitState.w < 0.22) {
      float age = hitState.w / 0.22;
      float d = length(normalize(v_local) - hitState.xyz);
      float radius = 0.035 + age * 0.58;
      ripple = exp(-pow((d - radius) / 0.025, 2.0)) * (1.0 - age) * 0.75;
      ripple += exp(-pow(d / 0.13, 2.0)) * (1.0 - age) * 0.36;
      alpha += ripple;
    }
    float breakup = 1.0;
    if (shieldState.w > 0.0) {
      float cells = fract(sin(dot(floor(v_uv * vec2(44.0, 28.0)), vec2(127.1, 311.7))) * 43758.5453);
      breakup = smoothstep(shieldState.w - 0.12, shieldState.w + 0.08, cells);
    }
    alpha *= reveal * shieldState.y * breakup;
    if (!gl_FrontFacing) alpha *= 0.36;
    if (alpha < 0.002) discard;
    // Fire uses display RGB like the other unlit fire passes. Keep the
    // existing alpha, depth and standard colour path for the other families.
    if (motifChannel.b > 0.5) {
      float heat = clamp(0.60 + rim*0.45 + glyph*0.38*shieldState.z + ripple*0.20, 0.0, 1.0);
      return vec4(fireFamilyColour(heat), min(alpha, 0.80));
    }
    vec3 tint = SRGBToLinear(shieldTint.rgb) + vec3(0.08 * rim + ripple * 0.18);
    return CCFragOutput(vec4(tint, min(alpha, 0.80)));
  }
}%
