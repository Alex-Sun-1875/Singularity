CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: fire-sprite-vs:vert
      frag: fire-sprite-fs:frag
      rasterizerState: { cullMode: none }
      depthStencilState: { depthTest: true, depthWrite: false }
      blendState:
        targets:
        - blend: true
          blendSrc: one
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
      properties:
        mainTexture: { value: white }
        mainColor: { value: [1, 1, 1, 1] }
        frameState: { value: [0, 1, 0, 0] }
        atlasState: { value: [8, 4, 32, 0] }
}%
CCProgram fire-sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec2 a_texCoord;
  out vec2 v_uv;
  vec4 vert () {
    v_uv = a_texCoord;
    return cc_matViewProj * cc_matWorld * vec4(a_position, 1.0);
  }
}%
CCProgram fire-sprite-fs %{
  precision highp float;
  in vec2 v_uv;
  uniform sampler2D mainTexture;
  uniform FireSpriteParams { vec4 mainColor; vec4 frameState; vec4 atlasState; };
  vec2 frameUV (float index) {
    float i = floor(index + 0.5);
    return (vec2(mod(i, atlasState.x), floor(i / atlasState.x)) + clamp(v_uv, vec2(0.003), vec2(0.997))) / atlasState.xy;
  }
  vec4 frag () {
    vec4 a = texture(mainTexture, frameUV(frameState.x));
    vec4 b = texture(mainTexture, frameUV(frameState.y));
    float t = clamp(frameState.z, 0.0, 1.0);
    // A rounded, feathered root removes the cropped horizontal boundary when
    // these reference wisps burn directly on the ground without the jet seal.
    float edge = 0.985 - 0.095 * pow(abs(v_uv.x * 2.0 - 1.0), 1.6);
    float rootFade = atlasState.w > 0.5 ? 1.0 : 1.0 - smoothstep(edge - 0.15, edge, v_uv.y);
    float alpha = mix(a.a, b.a, t) * mainColor.a * rootFade;
    if (alpha < 0.002) discard;
    vec3 premul = mix(a.rgb * a.a, b.rgb * b.a, t) * mainColor.rgb * mainColor.a * rootFade;
    // Same reference display colours as the approved ground jets, with one
    // continuous translucent layer rather than an additional white core.
    return vec4(premul * 1.10, alpha * 0.90);
  }
}%
