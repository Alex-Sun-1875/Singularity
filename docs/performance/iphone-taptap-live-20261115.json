{
  "title": "TapTap iPhone 真机性能定位：重复窗口查询与音量写入",
  "date": "2026-11-15",
  "timeZone": "Asia/Shanghai",
  "status": "diagnosis-complete-production-fix-not-applied",
  "environment": {
    "deviceProductType": "iPhone15,2",
    "hardwareModel": "D73AP",
    "iOS": "26.6.2",
    "transport": "USB / Apple Web Inspector",
    "appBundle": "com.easyplay.taptap.now",
    "runtimeVersion": "0.3.42",
    "engine": "Cocos Creator 3.8.8",
    "area": "H13",
    "logicalViewport": [
      852,
      393
    ],
    "canvas": [
      2556,
