    ],
    "frameRateSetting": 60,
    "renderer": "Apple GPU",
    "cleanupImageCache": true,
    "gpuTimerQuerySupported": false,
    "mode": "角色静止、存活、无菜单；17个敌人状态槽，16个存活；全部窗口移动距离与HP保持不变"
  },
  "conclusion": "本次真机的首要可复现瓶颈是每帧重复屏幕信息读取引起的同步平台桥接与调试日志格式化。事件驱动尺寸缓存的临时原型将同场景FPS从约33–35提高到约50，恢复后回落；绘制量、画布与帧率设置未变。背景音乐每帧重复写相同音量是另一条已定位的原生调用路径。尚未正式修改生产代码或验收持续战斗、GPU、温度。",
  "findings": [
    {
      "priority": 1,
      "name": "重复窗口信息查询",
      "evidence": "原样窗口中screen.windowSize正好5次/绘制帧，screen.devicePixelRatio正好1次/帧。设备上的Cocos窗口getter内部调用getWindowInfo两次，因此该静止路径对应约11次原生窗口查询/帧。调用栈含TapTap invokeSync/getWindowInfo、同步XHR send，以及API日志的Asia/Shanghai日期格式化。",
      "locations": [
        {
          "file": "src/cocos/assets/scripts/app/Hud.ts",
          "line": 495
        },
        {
          "file": "src/cocos/assets/scripts/features/combat/runtime/CombatImpactFeedback.ts",
          "line": 47
        },
        {
          "file": "src/cocos/assets/scripts/features/world/runtime/FlatWorldLayers.ts",
          "line": 240
        },
        {
          "file": "src/cocos/assets/scripts/features/combat/runtime/EnemyCombatFeedback.ts",
          "line": 83
        },
        {
          "file": "src/cocos/assets/scripts/features/journey/runtime/TaskPresence.ts",
          "line": 35
        }
      ],
      "optimization": "在shared/platform边界增加公共视口数据快照，统一保存物理尺寸、逻辑尺寸与DPR；初始化、Cocos窗口变化以及现有平台前台恢复入口刷新。HUD、投影、剔除和反馈读取同一快照。无受击效果时提前跳过其呈现计算。生产实现使用公共接口，不沿用诊断时覆盖引擎属性的手段。",
      "diagnostic": "同帧缓存15秒42.46FPS；恢复34.43FPS。事件刷新缓存15秒50.00FPS；恢复33.24FPS。所有这些窗口draw p50=107，triangles p50=128493。"
    },
    {
      "priority": 2,
      "name": "稳定音量仍每帧写入",
      "evidence": "BackgroundMusic.update在稳定音量0.28时仍每帧写AudioSource.volume；引擎setter继续写原生player并读回。窗口缓存后的调用栈中，775/2949个样本经过该更新入口。",
      "location": {
        "file": "src/cocos/assets/scripts/features/audio/runtime/BackgroundMusic.ts",
        "line": 61
      },
      "optimization": "在业务音频层记录上次实际提交音量，相同值不重复写；淡入淡出到达足够接近目标时吸附到目标，并停止重复提交。保留静音、开关、暂停、恢复和淡变行为。",
      "diagnostic": "与视口缓存合并时，在约17秒探针寿命中跳过860次完全相同音量写入，实际新写入0次；音乐仍播放、音量仍0.28。FPS50.33，恢复两项后33.10；相对只缓存视口的50.00，没有证实额外显著FPS收益。CPU观察下降不能作为严格隔离的音频优化百分比。"
    },
    {
      "priority": 3,
      "name": "缓存后剩余帧时间与高分辨率渲染",
      "evidence": "组合诊断仍只有约50FPS。实际画布3013524像素，是旧桌面1688×780样本的约2.29倍。GPU timer query不可用，未取得硬件GPU忙碌度、GPU毫秒、温度或热降频证据。",
      "optimization": "先落地前两项，再在同机同场景测移动战斗与热稳态。继续分析渲染提交、阴影、主角材质和透明层；通过平台工具或可用的Apple Instruments验证GPU。若需要渲染比例对照，须保留60FPS、触控映射和HUD清晰度并做画面验收。本轮不降低分辨率，也不把2.29倍像素推断为2.29倍GPU耗时。",
      "pixelRatioToOldReference": 2.288798760481225
    }
  ],
