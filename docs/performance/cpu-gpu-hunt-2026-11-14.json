      "locations": [
        "src/cocos/assets/scripts/features/combat/runtime/EnemyCombatFeedback.ts:188",
        "src/cocos/assets/scripts/features/equipment/runtime/GroundLootPresentation.ts:62",
        "src/cocos/assets/scripts/features/persistence/common/SaveStore.ts:47"
      ],
      "interpretation": "旧版投影重复读窗口尺寸已在所测冻结构建中缓存，当前不列为首要问题。掉落和存档可随游戏状态增大而影响后续成本，需要更长实测才能判断，非当前确定主因。"
    }
