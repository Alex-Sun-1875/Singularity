  "findings": [
    {
      "priority": 1,
      "part": "HUD/UI 与引擎提交",
      "cpu": "Root.frameMove约1.15ms/帧，其中UI.update约0.34–0.37ms/帧；Hud.update另约0.12–0.15ms/帧，内含MiniMap。",
      "gpuWorkload": "固定帧UI 109/170次绘制调用（64.1%），11367个三角形。",
      "locations": [
        "src/cocos/assets/scripts/app/Hud.ts:350",
        "src/cocos/assets/scripts/features/navigation/runtime/MiniMap.ts:70",
        "src/cocos/assets/scripts/features/combat/runtime/EnemyCombatFeedback.ts:108"
      ],
      "interpretation": "节点遍历、批次收集、Graphics/文字/贴图之间的提交；布局不变仍存在每帧渲染开销。应以具体绘制分项为后续优化依据。"
    },
    {
      "priority": 1,
      "part": "3D主角、发型、靴子、弓和箭袋",
      "gpuWorkload": "固定帧主角40次提交、115432个实际提交三角形，占总量83.0%；MeshRenderer库存的几何三角形与经过实际绘制路径后的统计不是同一口径。",
      "locations": [
        "src/cocos/assets/scripts/features/actors/runtime/Actors.ts:352",
        "src/cocos/assets/scripts/features/actors/runtime/NativeActorMaterials.ts:89",
        "src/cocos/assets/resources/actors/raphael/hair-curly.glb"
      ],
      "interpretation": "主角多部件和PBR/蒙皮是明确的GPU几何工作来源；已含本轮已有发型精简，不能重复把旧版减少量当新收益。尚未逐通道归因额外绘制遍数。"
    },
    {
      "priority": 2,
      "part": "战斗模拟、移动碰撞、视线",
      "cpu": "GameSession.advance约0.236–0.268ms/帧；其中move约0.096–0.105ms/帧，enemyStep约0.087–0.090ms/帧。SceneBuilder.visible约0.076–0.082ms/帧，和前述调用存在重叠。",
      "locations": [
        "src/cocos/assets/scripts/core/GameSession.ts:427",
        "src/cocos/assets/scripts/features/world/runtime/SceneBuilder.ts:631",
        "src/cocos/assets/scripts/features/navigation/runtime/Navigation.ts:10"
      ],
      "interpretation": "每步遍历敌人、移动/碰撞、Bullet视线；dt超过20ms时advance分多步，低帧时同帧计算会增多。敌人规模影响这部分，当前19个状态槽未随77次重生增加。"
    },
    {
      "priority": 2,
