  "principles": [
    "爽感来自短前摇、清晰命中停顿、可读击退、掉落马上看见，以及利用地形把一群敌人拆开；不依靠全屏数字或大量按钮。",
    "每章是可保存进度的连续区域，目标约20至40分钟。首章目标20至30分钟，分营地、山路、木门三个衔接区；退出后从已解锁检查点继续，不按短局重开。",
    "全篇只围绕把粮运到人手里这件事。剧情不谈神明、天命或世界末日；角色对白可跳过，跳过后目标仍清楚。",
    "俯视斜角2.5D呈现。美术严格沿用已选三人概念图的细致写实手绘方向：成人比例、自然布褶、皮革层次与钢铁质感。角色与装备组合保持原创，不照搬已有游戏人物；最终外观不能明显低模。"
  ],
  "scope_now": [
    "第一章三个连续区、三条局部路线、一个复用式头目",
    "单角色挥剑、推击、投油点火与一次改装选择",
    "三个检查点、稳定ID存档、固定箱子与少量奖励",
    "首章3个战斗角色先达到已选概念图的细致2.5D质感；现有静态灰盒用于尺寸、装备拆分与接入试验。"
  ],
  "scope_later": [
    "第二至第四章、盾兵与弩手、罗铎战",
    "骨骼绑定与正式动画、八方向扩展、更多音效和地形细节；不能以内部灰盒代替已选美术方向",
    "有限装备差异和最多三个战斗改装槽"
  ],
  "scope_excluded": [
    "联机攻城、开放世界、随机无限词条、宠物养成、职业转职树",
    "分支长篇对话、过场电影、昼夜与天气模拟、复杂制造树",
    "可燃建筑全破坏、真实流体、实时物理桥梁、不断刷新的防守波次"
  ],
  "plot": {
    "opening": "石桥营地等不到运粮车。行路人原本只是受雇护送，接下阿禾的委托，沿山路找车。第一次胜利是把人和粮带回来，不是卷入宏大的预言。",
    "development": "木门处的缴获清单指向旧矿道。老周认出旧轨道，行路人重新放下矿桥，发现粮油正依罗铎的命令被集中到河岸粮仓。此后目标明确为夺回补给线。",
    "turn": "河岸粮仓让“火”不只是伤害：玩家可以烧路障，但要保住粮食，并用水槽清出安全货道。阿禾开始组织搬运，营地不再只是领任务的菜单。",
    "ending": "罗铎关城门，声称只有把粮留在自己手里才能保城。玩家打败他，亲手转动绞盘，粮车入城，也给沿路聚落留粮。罗铎缴械，守备停止抵抗；普通人的来往恢复，故事收束。",
    "environmental_evidence": [
      "首章：断车轴、被划掉目的地的货签、木门上的收缴清单。",
      "第二章：旧矿工记号、重新转动的绞盘、盖着罗铎印记的账页。",
      "第三章：满仓与缺粮营地形成对照；粮袋可保全，杂物可燃。",
      "第四章：城外满载粮车与紧闭城门；战后开门与分粮是可见结果。"
    ],
    "rules": [
      "目标由动作完成，不由读完文本完成；每次交互只给一条明确动词目标。",
      "开场和收尾对白各不超过两句；字幕可跳过，无强制镜头锁定。",
      "三条路线是同一目标的不同战术，不产生互斥剧情或多个结局。",
      "关键粮食和任务交互不可烧毁；失误带来局部战斗压力，不让主线软锁。"
    ]
  },
