  "status": "measurement ROI configuration only; do not use these color gates as generation or composite masks",
  "manifestSHA256": "4065d59acbccb8c85642cf31cab840a8fce3577a87806ce2c558096098b41df8",
  "method": {
    "coordinates": "Absolute source-atlas XY, half-open ROI endpoints; frameRect is XYWH from current manifest. No rescale or compositing for measurement.",
    "roiDefinition": {
      "wineBody": "whole frame width, y=.20h..56h of manifest crop",
      "blueBiasedSleeveCandidate": "whole frame width, y=.17h..48h of manifest crop",
      "sensitivity": "wineBody .16h..60h; sleeve .15h..60h"
    },
    "interiorMask": "alpha>=250 then scipy.ndimage.binary_erosion, 3x3 connectivity-default cross, 2 iterations",
    "wineBodyGate": "HSV hue >=345 or <=15 deg; S22..80%; V10..86%; R>=B+5",
    "blueBiasedSleeveGate": "B>=R+2 and B>=G+2; S1.5..40%; V10..70.6%",
    "colorSpace": "Stored RGB treated as sRGB because no embedded gAMA/sRGB/iCCP/cHRM. Pillow ImageCms sRGB -> Lab D50. L* from 8bit Lab /255*100, signed a/b bytes decoded. HSV from Pillow 8bit HSV; hue circular mean.",
    "comparison": "Median of each phase median; compare each direction separately with its idle. deltaE76 is Euclidean difference of these masked median Lab vectors; not CIEDE2000 or a paired-pixel perceptual proof.",
    "limitations": [
      "ROIs are geometric upper-torso bands, not hand-traced garment semantic masks; sleeve candidates can include pauldron/metal or other blue-biased low-chroma fabric.",
      "Red selection can include warm red leather straps or shaded red cloth. Belt/skin are reduced by hue selection but cannot be guaranteed absent without local visual review.",
      "Shoulder/arm pose, chest perspective, folds, sword occlusion and baked lighting vary by phase; distributions do not identify intrinsic albedo independently of shading.",
      "Very low sleeve chroma makes hue unstable; judge L*, RGB/chroma and local visual appearance together.",
      "No image was opened through view_image, browser, computer vision upload or remote image service; no visual acceptance claim."
    ]
  },
